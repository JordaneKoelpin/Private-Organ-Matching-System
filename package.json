{
  "name": "fhevm-private-organ-matching",
  "version": "1.0.0",
  "description": "A secure, privacy-preserving organ donor matching system using FHEVM (Fully Homomorphic Encryption Virtual Machine)",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify": "hardhat verify --network sepolia",
    "clean": "hardhat clean",
    "generate:docs": "ts-node scripts/generate-docs.ts",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.ts'",
    "dev": "hardhat node"
  },
  "keywords": [
    "FHEVM",
    "FHE",
    "Encrypted",
    "Privacy",
    "Healthcare",
    "Organ Matching",
    "Smart Contracts",
    "Solidity",
    "Zama"
  ],
  "author": "Privacy Organ Matching Contributors",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.3.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.1.1",
    "solhint": "^4.0.1",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
